{
  "name": "desktop-agent",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "松鼠Pad macOS 桌面伴侣被控端 (Squirrel Pad Desktop Agent)",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "node scripts/build-main.mjs --watch",
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "package:mac:x64": "npm run build && electron-builder --mac --x64",
    "package:mac:intel": "npm run build && electron-builder --mac --x64",
    "package:mac:universal": "npm run build && electron-builder --mac --universal",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:win:portable": "npm run build && electron-builder --win portable --x64",
    "package:win:zip": "npm run build && electron-builder --win zip --x64",
    "package:all": "npm run build && electron-builder --mac --win",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.4",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "y-codemirror.next": "^0.3.5",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.23"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "author": "Squirrel Pad",
  "build": {
    "appId": "com.squirrelpad.desktopagent",
    "productName": "松鼠Pad 桌面端",
    "electronVersion": "34.2.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "${productName}-macOS-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Windows-${version}-${arch}.${ext}",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "松鼠Pad 桌面端",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Windows-${version}-Portable.${ext}"
    }
  }
}
